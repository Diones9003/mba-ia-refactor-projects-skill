# Copie para .env e preencha os valores. O .env NÃO deve ser versionado.

# Chave usada para assinatura de sessões/tokens. Gere uma nova por ambiente:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# development | production
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

HOST=127.0.0.1
PORT=5000

DATABASE_PATH=loja.db
# Popula produtos/usuários de exemplo no primeiro boot
SEED_DATABASE=true

# Origens permitidas para CORS, separadas por vírgula
ALLOWED_ORIGINS=http://localhost:3000
