# Copie para `.env` e ajuste. O `.env` NÃO é versionado.

# --- Aplicação ---
# development | production | testing
APP_ENV=development
# Gere um valor forte: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO

# --- Banco de dados ---
DATABASE_URL=sqlite:///tasks.db

# --- CORS ---
# Lista separada por vírgula. Use '*' apenas em desenvolvimento.
CORS_ORIGINS=http://localhost:3000

# --- Autenticação ---
# false reproduz o contrato legado (endpoints anônimos). Mantenha true.
REQUIRE_AUTH=true
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
MIN_PASSWORD_LENGTH=4

# --- Paginação (opt-in: só se a request enviar page/per_page) ---
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200

# --- Notificações por e-mail ---
NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
