# Copie este arquivo para .env e preencha com valores reais.
# O .env NAO deve ser versionado (ja esta no .gitignore da raiz do repositorio).

# Ambiente e servidor
NODE_ENV=development
PORT=3000

# Banco de dados (":memory:" para banco volatil ou um caminho de arquivo .db)
DATABASE_PATH=:memory:
SEED_DATABASE=true

# Credenciais / integracoes (obrigatorias)
PAYMENT_GATEWAY_KEY=

# Integracoes opcionais
SMTP_USER=
